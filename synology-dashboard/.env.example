# Copy to .env on the Synology and fill in from 1Password.
# Never commit .env.

AUTOTASK_USER=
AUTOTASK_SECRET=
AUTOTASK_INTEGRATION_CODE=

# Optional tuning
PORT=3000
CACHE_TTL_SECONDS=60
# Comma-separated status IDs that count as "Complete". Autotask default = 5.
COMPLETE_STATUS_IDS=5
# monday or sunday
WEEK_START_DAY=monday
