# Copy to op.env on the Synology and replace the op:// paths with the
# actual vault/item/field references from your 1Password vault.
# Launch the stack with:
#
#   op run --env-file=op.env -- docker compose up -d --build
#
# For unattended start (after a NAS reboot, scheduled tasks, etc.) use a
# 1Password service-account token in the shell that runs `op run`:
#
#   export OP_SERVICE_ACCOUNT_TOKEN=ops_...
#
# op.env is safe to commit only if it contains references, not real
# secrets. .gitignore excludes it by default to be cautious.

AUTOTASK_USER=op://YourVault/Autotask API/username
AUTOTASK_SECRET=op://YourVault/Autotask API/credential
AUTOTASK_INTEGRATION_CODE=op://YourVault/Autotask API/integration code

# Non-secret tuning — literal values are passed through unchanged by `op run`.
PORT=3000
CACHE_TTL_SECONDS=60
COMPLETE_STATUS_IDS=5
WEEK_START_DAY=monday
