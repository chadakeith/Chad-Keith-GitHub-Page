---
import Base from "../layouts/Base.astro";
import jsonLd from "../data/jsonld/index.json";
---

<Base
  title="Chad Keith"
  description="Chad Keith's personal hub — Apple IT consultant in the Charlotte area, founder of Atlas, plus side projects like Where's Wren, Overcoming Average, and Behind the Mac."
  path="/"
  ogType="website"
  image="/images/chad-keith.jpg"
  jsonLd={jsonLd}
>
<div class="hero">
    <img src="/images/chad-keith.jpg" alt="Chad Keith, president of Atlas Technology Solutions" class="hero-avatar" width="152" height="152">
    <h1>Chad Keith</h1>
    <p>Apple IT consultant in the Charlotte, NC area with nearly two decades in technology — helping organizations deploy, manage, and automate Apple fleets, Google Workspace, and practical AI workflows.</p>
    <div class="hero-links">
      <a href="/about.html" class="btn btn-primary">About Me</a>
      <a href="/credentials.html" class="btn btn-secondary">Credentials</a>
      <a href="https://www.linkedin.com/in/chadwickkeith/" target="_blank" rel="noopener" class="btn btn-secondary">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
        LinkedIn
      </a>
      <a href="https://github.com/chadakeith" target="_blank" rel="noopener" class="btn btn-secondary">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
        GitHub
      </a>
    </div>
  </div>

  <div class="atlas-banner">
    <p>Apple device management, Google Workspace, managed IT, and <a href="https://atlassolutions.tech" target="_blank" rel="noopener">Atlas AI consulting</a> through <a href="https://atlascarolina.com" target="_blank" rel="noopener">Atlas Technology Solutions — Apple IT experts for Charlotte and the Carolinas</a></p>
  </div>

  <section id="side-quests">
    <div class="section-label">Side quests</div>
    <h2>Side quests</h2>
    <p class="section-desc">Other things I work on when I'm not in Jamf or Google Workspace.</p>
    <div class="quests-grid">
      <a class="quest-card" href="https://overcomingaverage.net" target="_blank" rel="noopener">
        <h3>Overcoming Average</h3>
        <p>My podcast and personal brand roots — stories from people who refuse to stay stuck on average.</p>
        <span class="quest-url">overcomingaverage.net</span>
      </a>
      <a class="quest-card" href="https://behindthemac.com" target="_blank" rel="noopener">
        <h3>Behind the Mac</h3>
        <p>The Man Behind the Mac voice — personal Apple notes, not the Atlas site.</p>
        <span class="quest-url">behindthemac.com</span>
      </a>
      <a class="quest-card" href="https://chadthetechdad.com" target="_blank" rel="noopener">
        <h3>Chad the Tech Dad</h3>
        <p>Home-life tech, kid-friendly experiments, and whatever I'm tinkering with after work.</p>
        <span class="quest-url">chadthetechdad.com</span>
      </a>
      <a class="quest-card" href="https://whereiswren.com" target="_blank" rel="noopener">
        <h3>Where's Wren</h3>
        <p>A daily geography hide-and-seek game I built for families — find Wren on the globe.</p>
        <span class="quest-url">whereiswren.com</span>
      </a>
      <a class="quest-card" href="https://atlascarolina.com" target="_blank" rel="noopener">
        <h3>Atlas Carolina</h3>
        <p>The day job: Apple IT, Jamf, and managed services for businesses that need it done right.</p>
        <span class="quest-url">atlascarolina.com</span>
      </a>
    </div>
  </section>

  <div class="divider"></div>

  <section id="about">
    <div class="section-label">Background</div>
    <h2>About Me</h2>
    <div class="about-grid">
      <div class="about-text">
        <p>I'm a computer engineer turned IT consultant and business owner. After earning my BS in Computer Engineering from UNC Charlotte, I spent over a decade building and running IT operations — including six years growing a Charlotte break/fix shop into a full managed service provider as its Director of Operations.</p>
        <p>In 2018 I founded <a href="https://atlascarolina.com" target="_blank" rel="noopener">Atlas Technology Solutions</a>, an Apple Consultants Network member and certified Jamf partner based in Davidson, NC. We help businesses across the Carolinas deploy and manage Apple devices, administer Google Workspace, automate IT work — and through <a href="https://atlassolutions.tech" target="_blank" rel="noopener">Atlas AI</a>, put practical AI to work safely.</p>
        <p><a href="/about.html">Read the full story →</a> · <a href="/credentials.html">Credentials →</a></p>
      </div>
      <div class="about-stats">
        <div class="stat-card">
          <div class="num">2006</div>
          <div class="label">In technology since — BS Computer Engineering, UNC Charlotte</div>
        </div>
        <div class="stat-card">
          <div class="num">2018</div>
          <div class="label">Founded Atlas Technology Solutions</div>
        </div>
        <div class="stat-card">
          <div class="num">Jamf + AI</div>
          <div class="label">Credly Jamf badges + MasterClass AI &amp; Leadership certificates (2026)</div>
        </div>
      </div>
    </div>
  </section>

  <div class="divider"></div>

  <section id="skills">
    <div class="section-label">Expertise</div>
    <h2>Skills &amp; Tools</h2>
    <p class="section-desc">Core technologies I work with day to day — built on Apple and Jamf certifications and hands-on deployments from small offices to fleets of thousands of endpoints.</p>
    <div class="skills-grid">
      <div class="skill-card">
        <span class="skill-icon">✦</span>
        <h3>Atlas AI</h3>
        <p>AI integrations, agentic workflows, training, and security — MasterClass AI Fundamentals</p>
      </div>
      <div class="skill-card">
        <span class="skill-icon">🍎</span>
        <h3>Jamf Pro</h3>
        <p>Apple device management, policy deployment, and MDM automation — Jamf Management Engineer</p>
      </div>
      <div class="skill-card">
        <span class="skill-icon">☁️</span>
        <h3>Google Workspace</h3>
        <p>GAM-based administration, user provisioning, and org management</p>
      </div>
      <div class="skill-card">
        <span class="skill-icon">🐍</span>
        <h3>Python</h3>
        <p>Automation bots, audit tooling, and IT workflow scripts</p>
      </div>
      <div class="skill-card">
        <span class="skill-icon">🖥️</span>
        <h3>Shell Scripting</h3>
        <p>Bash scripts for deployment, configuration, and system tasks</p>
      </div>
      <div class="skill-card">
        <span class="skill-icon">🌐</span>
        <h3>Network Infrastructure</h3>
        <p>Routing, switching, and wireless deployments — UniFi, pfSense, Meraki, and more</p>
      </div>
      <div class="skill-card">
        <span class="skill-icon">🔒</span>
        <h3>Security &amp; Audit</h3>
        <p>Compliance reporting and automated audit workflows</p>
      </div>
    </div>
  </section>

  <div class="divider"></div>

  <section id="projects">
    <div class="section-label">Work</div>
    <h2>Projects</h2>
    <p class="section-desc">A selection of tools and scripts built for real IT environments. See the <a href="/tools.html" style="color: var(--accent); text-decoration: none;">Tools page</a> for the full toolbox.</p>
    <div class="projects-grid">

      <div class="project-card">
        <h3>Atlas Jamf Scripts</h3>
        <p>Scripts for Jamf MDM instances — automating device policies, enrollment workflows, and macOS configuration tasks.</p>
        <div class="project-footer">
          <span class="lang-label"><span class="lang-dot" style="background:#28cd41"></span> Shell</span>
          <span class="tag">MDM</span>
          <span class="tag">macOS</span>
        </div>
      </div>

      <div class="project-card">
        <h3>Atlas GAM Scripts</h3>
        <p>GAM-based scripts for Google Workspace administration — user lifecycle management, group operations, and reporting.</p>
        <div class="project-footer">
          <span class="lang-label"><span class="lang-dot" style="background:#28cd41"></span> Shell</span>
          <span class="tag">Google Workspace</span>
          <span class="tag">GAM</span>
        </div>
      </div>

      <div class="project-card">
        <h3>Autotask Team Dashboard</h3>
        <p>Self-hosted Node.js dashboard showing open tickets per team member and weekly close rates, pulled live from the Autotask PSA API. Runs in Docker with secrets managed by the 1Password CLI.</p>
        <div class="project-footer">
          <span class="lang-label"><span class="lang-dot" style="background:#f1e05a"></span> JavaScript</span>
          <span class="tag">Autotask</span>
          <span class="tag">Docker</span>
        </div>
      </div>

    </div>
  </section>

  <div class="divider"></div>

  <section id="archive">
    <div class="section-label">From the archive</div>
    <h2>From the archive</h2>
    <p class="section-desc">A handful of posts from 2018.</p>
    <div class="blog-list">
      <a class="archive-item" href="/blog/why-do-millennials-quit-everything.html">
        <h3>Why do Millennials quit everything?</h3>
        <time datetime="2018-06-21">June 21, 2018</time>
      </a>
      <a class="archive-item" href="/blog/my-murphy.html">
        <h3>My Murphy</h3>
        <time datetime="2018-05-19">May 19, 2018</time>
      </a>
      <a class="archive-item" href="/blog/know-your-audience-nascar-christians.html">
        <h3>Know your Audience/NASCAR Christians</h3>
        <time datetime="2018-05-06">May 6, 2018</time>
      </a>
      <a class="archive-item" href="/blog/false-start.html">
        <h3>False Start</h3>
        <time datetime="2018-04-30">April 30, 2018</time>
      </a>
      <a class="archive-item" href="/blog/bottom-of-the-list.html">
        <h3>Bottom of the list</h3>
        <time datetime="2018-04-30">April 30, 2018</time>
      </a>
      <a class="archive-item" href="/blog/the-begining.html">
        <h3>The Begining</h3>
        <time datetime="2018-04-14">April 14, 2018</time>
      </a>
    </div>
    <p class="blog-post-nav"><a href="/blog/">All posts →</a></p>
  </section>

  <section>
    <div class="cta-panel">
      <h2>Need help with Apple fleets or AI?</h2>
      <p>Atlas Technology Solutions provides Apple certified consulting, managed IT, and Atlas AI services for businesses in Charlotte and across the Carolinas.</p>
      <div class="hero-links">
        <a href="/services.html" class="btn btn-primary">What We Do</a>
        <a href="https://atlassolutions.tech" target="_blank" rel="noopener" class="btn btn-secondary">Visit Atlas AI</a>
        <a href="https://atlascarolina.com" target="_blank" rel="noopener" class="btn btn-secondary">Visit atlascarolina.com</a>
      </div>
      <p class="cta-contact"><a href="mailto:consulting@atlascarolina.com">consulting@atlascarolina.com</a> &nbsp;·&nbsp; <a href="tel:+17048972690">704-897-2690</a></p>
    </div>
  </section>
</Base>
