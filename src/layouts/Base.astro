---
import Footer from "../components/Footer.astro";
import Nav from "../components/Nav.astro";
import { MEASUREMENT_ID, SITE } from "../data/site";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  path: string;
  ogType?: string;
  image?: string;
  jsonLd?: unknown;
  articleDate?: string;
}

const {
  title,
  description,
  path,
  ogType = "website",
  image,
  jsonLd,
  articleDate,
} = Astro.props;

const canonical = new URL(path, SITE).href;
const imageUrl = image ? new URL(image, SITE).href : undefined;

function jsonScript(value: unknown) {
  return JSON.stringify(value).replace(/</g, "\\u003c");
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Chad Keith" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Chad Keith" />
    <meta property="og:locale" content="en_US" />
    {imageUrl && <meta property="og:image" content={imageUrl} />}
    {imageUrl && <meta property="og:image:alt" content="Chad Keith" />}
    <meta name="twitter:card" content={imageUrl ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {imageUrl && <meta name="twitter:image" content={imageUrl} />}
    {articleDate && <meta property="article:published_time" content={articleDate} />}
    {jsonLd && <script is:inline type="application/ld+json" set:html={jsonScript(jsonLd)} />}
    <script async src={`https://www.googletagmanager.com/gtag/js?id=${MEASUREMENT_ID}`}></script>
    <script is:inline define:vars={{ MEASUREMENT_ID }}>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag("js", new Date());
      gtag("config", MEASUREMENT_ID);
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Nav path={path} />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
